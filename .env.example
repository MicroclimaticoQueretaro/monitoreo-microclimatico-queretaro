# Plantilla de variables de entorno.
# Copiar este archivo como .env y completar con valores reales:  cp .env.example .env
# El archivo .env está en .gitignore y NUNCA debe subirse a GitHub.

# --- Base de datos (docker-compose) ---
POSTGRES_USER=microclima_admin
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
POSTGRES_DB=microclima_db
POSTGRES_PORT=5433

# --- Red WiFi del ESP32 ---
WIFI_SSID=SU_RED_AQUI
WIFI_PASSWORD=SU_CONTRASENA_AQUI

# --- Llaves de servicios externos (futuro) ---
API_KEY_SATELITE=SU_LLAVE_AQUI
