# Plantilla de variables de entorno.
# Copiar este archivo como .env y completar con valores reales:  cp .env.example .env
# El archivo .env está en .gitignore y NUNCA debe subirse a GitHub.

# --- Base de datos (docker-compose) ---
POSTGRES_USER=microclima_admin
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
POSTGRES_DB=microclima_db
POSTGRES_PORT=5433

# --- API ---
# 127.0.0.1 = solo esta computadora | 0.0.0.0 = toda la red local (necesario para el ESP32)
API_HOST_BIND=127.0.0.1

# --- Red WiFi y token del ESP32 ---
# NO van aquí: el ESP32 no lee este archivo.
# Se configuran en iot/firmware/include/secretos.h (ver iot/firmware/README.md)

# --- MQTT (EMQX Cloud): la API envía las órdenes activar / detener ---
# Usar la credencial de la API (NO la del ESP32). Vacío = control remoto desactivado.
MQTT_HOST=
MQTT_PUERTO=8883
MQTT_USUARIO=
MQTT_CONTRASENA=
